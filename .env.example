# OpenAI 兼容接口配置（DeepSeek / Qwen / OpenAI 均可）
QUANTRA_LLM_BASE_URL=https://api.deepseek.com/v1
QUANTRA_API_KEY=
QUANTRA_PRIMARY_MODEL=deepseek-v4-pro
QUANTRA_CHEAP_MODEL=deepseek-v4-flash

# 不配置 API Key 时自动进入 dry-run 确定性模式（零成本）
QUANTRA_DRY_RUN=1

# 本地 SQLite 路径（相对项目根目录）
QUANTRA_DB_PATH=data/quantra.db
